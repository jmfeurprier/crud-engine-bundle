{
    "name": "jmf/crud-engine-bundle",
    "description" : "CRUD engine bundle for Symfony",
    "license": "mit",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.3",
        "doctrine/instantiator": "^2.0",
        "doctrine/orm": "^3.0",
        "jmf/template-rendering": "^1.0",
        "symfony/form": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/string": "^7.3",
        "twig/extra-bundle": "^3.21",
        "twig/string-extra": "^3.21",
        "webmozart/assert": "^1.0"
    },
    "require-dev": {
        "phpmd/phpmd": "^2.15.0",
        "phpstan/phpstan": "^2.1.17",
        "phpunit/phpunit": "^12.1.6",
        "rector/rector": "^2.0.17",
        "squizlabs/php_codesniffer": "^3.13.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\CrudEngine\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\CrudEngine\\Tests\\": "tests/unit"
        }
    }
}
