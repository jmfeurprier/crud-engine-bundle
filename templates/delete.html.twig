{#
    Built-in CRUD engine fallback template for the "delete" action.
    It is intentionally bare: copy it to your application's configured view path
    (e.g. templates/{entity}/delete.html.twig) to customize it.
    Submitting this form (POST) confirms the deletion.
#}
<form method="post">
    <p>Are you sure you want to delete this item?</p>
    <button type="submit">Delete</button>
</form>
